<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SID Warrant Registration</title>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --ink:     #1a1a2e;
    --paper:   #f5f0e8;
    --cream:   #ede8db;
    --rule:    #c8bfaa;
    --accent:  #2d5016;
    --accent2: #8b3a0f;
    --muted:   #6b6354;
    --success: #2d5016;
    --error:   #8b3a0f;
    --mono:    'DM Mono', monospace;
    --serif:   'Libre Baskerville', Georgia, serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    min-height: 100vh;
    background-image:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 27px,
        rgba(180,170,150,0.18) 27px,
        rgba(180,170,150,0.18) 28px
      );
  }

  /* ── Header ── */
  header {
    border-bottom: 2px solid var(--ink);
    padding: 28px 48px 20px;
    display: flex;
    align-items: baseline;
    gap: 24px;
  }
  header h1 {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  header .sub {
    font-size: 0.78rem;
    font-family: var(--mono);
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .stamp {
    margin-left: auto;
    border: 2px solid var(--accent);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    transform: rotate(-1.5deg);
  }

  /* ── Main layout ── */
  main {
    max-width: 860px;
    margin: 0 auto;
    padding: 40px 48px 80px;
  }

  /* ── Section label ── */
  .section-label {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  /* ── Upload zone ── */
  #drop-zone {
    border: 1.5px dashed var(--rule);
    background: var(--cream);
    padding: 40px;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    position: relative;
    margin-bottom: 28px;
  }
  #drop-zone:hover, #drop-zone.drag-over {
    border-color: var(--accent);
    background: #eae6da;
  }
  #drop-zone input[type=file] {
    position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
  }
  .drop-icon {
    font-size: 2rem;
    margin-bottom: 10px;
    display: block;
    opacity: 0.5;
  }
  .drop-label {
    font-size: 0.88rem;
    color: var(--muted);
    font-family: var(--mono);
  }
  .drop-label strong { color: var(--ink); }
  #file-name {
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent);
    min-height: 1.2em;
  }

  /* ── Date fields ── */
  .date-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 28px;
  }
  .field label {
    display: block;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .field input[type=date] {
    width: 100%;
    background: var(--cream);
    border: 1.5px solid var(--rule);
    padding: 10px 14px;
    font-family: var(--mono);
    font-size: 0.88rem;
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s;
    -webkit-appearance: none;
  }
  .field input[type=date]:focus { border-color: var(--accent); }

  /* ── Submit button ── */
  #submit-btn {
    width: 100%;
    background: var(--ink);
    color: var(--paper);
    border: none;
    padding: 14px 24px;
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    margin-bottom: 36px;
  }
  #submit-btn:hover:not(:disabled) { background: var(--accent); }
  #submit-btn:active:not(:disabled) { transform: translateY(1px); }
  #submit-btn:disabled { opacity: 0.45; cursor: not-allowed; }

  /* ── Progress ── */
  #progress {
    display: none;
    text-align: center;
    padding: 24px;
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--muted);
    letter-spacing: 0.05em;
    margin-bottom: 24px;
  }
  .spinner {
    display: inline-block;
    width: 16px; height: 16px;
    border: 2px solid var(--rule);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    vertical-align: middle;
    margin-right: 10px;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Error ── */
  #error-box {
    display: none;
    background: #fdf2ed;
    border: 1.5px solid var(--accent2);
    padding: 14px 18px;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent2);
    margin-bottom: 24px;
  }

  /* ── Results panel ── */
  #results {
    display: none;
    animation: fadeIn 0.4s ease;
  }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  .result-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 14px 0 10px;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 4px;
  }
  .result-header h2 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .result-header .sid-badge {
    font-family: var(--mono);
    font-size: 0.72rem;
    background: var(--ink);
    color: var(--paper);
    padding: 3px 10px;
    letter-spacing: 0.08em;
  }

  /* ── Warrant tables ── */
  .warrant-section { margin-bottom: 28px; }
  .warrant-section h3 {
    font-size: 0.72rem;
    font-family: var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 16px 0 8px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
  }
  .warrant-section h3 .maturity {
    color: var(--accent2);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }
  thead th {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: left;
    padding: 6px 10px 6px 0;
    border-bottom: 1px solid var(--rule);
    font-weight: 500;
  }
  thead th.right { text-align: right; }
  tbody tr { border-bottom: 1px solid rgba(200,191,170,0.4); }
  tbody tr:hover { background: rgba(200,191,170,0.15); }
  tbody td {
    padding: 7px 10px 7px 0;
    vertical-align: middle;
  }
  td.wt-num {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    width: 60px;
  }
  td.amount {
    font-family: var(--mono);
    font-size: 0.82rem;
    text-align: right;
    white-space: nowrap;
  }
  td.payee { color: var(--ink); }
  td input[type=text], td input[type=number] {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--rule);
    font-family: inherit;
    font-size: inherit;
    color: var(--ink);
    width: 100%;
    padding: 2px 4px;
    outline: none;
  }
  td input:focus { border-bottom-color: var(--accent); }

  tfoot td {
    padding: 8px 10px 4px 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 500;
    border-top: 1.5px solid var(--ink);
  }
  tfoot td.total-label { color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.68rem; }
  tfoot td.total-amount { text-align: right; }

  /* ── Note about edits ── */
  .edit-note {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    font-style: italic;
    margin-bottom: 20px;
    padding: 10px 14px;
    background: var(--cream);
    border-left: 3px solid var(--rule);
  }

  /* ── Flags panel ── */
  .flag-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 14px;
    margin-bottom: 6px;
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .flag-item.error {
    background: #fdf2ed;
    border: 1.5px solid var(--accent2);
    color: var(--accent2);
  }
  .flag-item.warning {
    background: #fdf8ed;
    border: 1.5px solid #a07820;
    color: #7a5c10;
  }
  .flag-badge {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 2px 7px;
    white-space: nowrap;
    margin-top: 1px;
  }
  .flag-item.error   .flag-badge { background: var(--accent2); color: #fff; }
  .flag-item.warning .flag-badge { background: #a07820; color: #fff; }
  .flag-warrant {
    font-weight: 500;
    margin-right: 4px;
  }
  #flags-acknowledge {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    cursor: pointer;
    display: flex !important;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
  }

  /* ── Download button disabled state ── */
  #download-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    width: 100%;
    background: var(--accent);
    color: #fff;
    border: none;
    padding: 14px 24px;
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    margin-top: 8px;
  }
  #download-btn:hover { background: #1e3a0f; }
  #download-btn:active { transform: translateY(1px); }

  /* ── Reset link ── */
  .reset-link {
    display: block;
    text-align: center;
    margin-top: 16px;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    cursor: pointer;
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .reset-link:hover { color: var(--ink); }
  /* ── Tab navigation ── */
  .tab-nav {
    display: flex;
    gap: 4px;
    margin-bottom: 28px;
    border-bottom: 2px solid var(--rule);
    padding-bottom: 0;
  }
  .tab-btn {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 8px 18px;
    border: 1px solid var(--rule);
    border-bottom: none;
    background: var(--cream);
    color: var(--muted);
    cursor: pointer;
    border-radius: 3px 3px 0 0;
    position: relative;
    bottom: -2px;
    transition: color 0.15s, background 0.15s;
  }
  .tab-btn.active {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--rule);
    border-bottom: 2px solid var(--paper);
    font-weight: 500;
  }
  .tab-btn:hover:not(.active) { color: var(--ink); }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* ── GF Calls panel ── */
  #calls-result {
    margin-top: 20px;
    padding: 16px;
    background: var(--cream);
    border: 1px solid var(--rule);
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--ink);
    display: none;
  }
  #calls-result.success { border-color: var(--success); color: var(--success); }
  #calls-result.error   { border-color: var(--error);   color: var(--error); }
  #calls-download-btn {
    margin-top: 16px;
    display: none;
  }
  /* ── Warrant Query ── */
  #query-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(45,80,22,0.08);
  }
  .query-entry {
    margin-bottom: 24px;
    border-left: 3px solid var(--rule);
    padding-left: 14px;
  }
  .query-entry .q-label {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .query-entry .q-text {
    font-size: 0.88rem;
    color: var(--ink);
    margin-bottom: 10px;
    font-style: italic;
  }
  .query-entry .a-label {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .query-entry .a-text {
    font-size: 0.88rem;
    color: var(--ink);
    line-height: 1.6;
    white-space: pre-wrap;
  }
</style>
</head>
<body>

<header>
  <h1>SID Warrant Registration</h1>
  <span class="sub">Bluestem Capital Partners</span>
  <span class="stamp">Automated</span>
  <a href="/logout" style="margin-left:16px; font-family:var(--mono); font-size:0.68rem; color:var(--muted); letter-spacing:0.08em; text-decoration:none; text-transform:uppercase;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--muted)'">Sign out</a>
</header>

<main>

  <!-- ── Tab navigation ── -->
  <div class="tab-nav">
    <button class="tab-btn active" onclick="switchTab('registration', this)">Warrant Registration</button>
    <button class="tab-btn" onclick="switchTab('gf-calls', this)">GF Warrant Calls</button>
    <button class="tab-btn" onclick="switchTab('ach-report', this)">ACH File Report</button>
    <button class="tab-btn" onclick="switchTab('warrant-query', this)">Warrant Query</button>
  </div>

  <!-- ══════════════════════════════════════════════ -->
  <!-- Tab 1: Warrant Registration (existing content) -->
  <!-- ══════════════════════════════════════════════ -->
  <div id="tab-registration" class="tab-panel active">

  <!-- ── Upload Form ── -->
  <div id="upload-form">
    <div class="section-label">Step 1 — Upload Minutes PDF</div>
    <div id="drop-zone">
      <input type="file" id="pdf-input" accept="application/pdf">
      <span class="drop-icon">📄</span>
      <div class="drop-label"><strong>Click to select</strong> or drag & drop</div>
      <div class="drop-label" style="margin-top:4px">Meeting minutes PDF</div>
      <div id="file-name"></div>
    </div>

    <div class="section-label">Step 2 — Enter Dates</div>
    <div class="date-row">
      <div class="field">
        <label>Issue Date (Dt Wt)</label>
        <input type="date" id="dt-wt">
      </div>
      <div class="field">
        <label>Registration Date (Dt Reg)</label>
        <input type="date" id="dt-reg">
      </div>
    </div>

    <div class="section-label">Step 3 — Extract & Review</div>
    <button id="submit-btn" disabled>Extract Warrant Data</button>
  </div>

  <!-- ── Progress ── -->
  <div id="progress">
    <span class="spinner"></span>
    <span id="progress-msg">Reading PDF with AI…</span>
  </div>

  <!-- ── Error ── -->
  <div id="error-box"></div>

  <!-- ── Results ── -->
  <div id="results">
    <div class="result-header">
      <h2 id="result-title">Extracted Warrants</h2>
      <span class="sid-badge" id="sid-badge"></span>
    </div>

  <!-- ── Flags panel ── -->
  <div id="flags-panel" style="display:none; margin-bottom:20px;">
    <div id="flags-list"></div>
    <label id="flags-acknowledge" style="display:none; font-family:var(--mono); font-size:0.78rem; color:var(--muted); cursor:pointer; display:flex; align-items:center; gap:8px; margin-top:10px;">
      <input type="checkbox" id="flags-ack-check"> I have reviewed the warnings above and want to proceed
    </label>
  </div>

  <div class="edit-note">✎ &nbsp;Review and edit any values below before downloading.</div>

    <!-- General warrants -->
    <div class="warrant-section">
      <h3>General Fund Warrants <span class="maturity">3-year maturity</span></h3>
      <table id="gf-table">
        <thead>
          <tr>
            <th>Wt #</th>
            <th>Payee</th>
            <th class="right">Amount</th>
          </tr>
        </thead>
        <tbody id="gf-body"></tbody>
        <tfoot>
          <tr>
            <td colspan="2" class="total-label">Total</td>
            <td class="total-amount" id="gf-total"></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- Construction warrants -->
    <div class="warrant-section">
      <h3>Construction Fund Warrants <span class="maturity">5-year maturity</span></h3>
      <table id="cf-table">
        <thead>
          <tr>
            <th>Wt #</th>
            <th>Payee</th>
            <th class="right">Amount</th>
          </tr>
        </thead>
        <tbody id="cf-body"></tbody>
        <tfoot>
          <tr>
            <td colspan="2" class="total-label">Total</td>
            <td class="total-amount" id="cf-total"></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <button id="download-btn">⬇ Download Packet Files</button>
    <span class="reset-link" id="reset-link">← Start over with a new PDF</span>
  </div>

  </div><!-- end tab-registration -->

  <!-- ══════════════════════════════════════════════ -->
  <!-- Tab 2: GF Warrant Calls                        -->
  <!-- ══════════════════════════════════════════════ -->
  <div id="tab-gf-calls" class="tab-panel">

    <div id="calls-upload-form">
      <div class="section-label">Step 1 — Upload Cash Balances File</div>
      <div id="calls-drop-zone" class="drop-zone" style="margin-bottom:20px;">
        <input type="file" id="calls-file-input" accept=".xlsx,.xls">
        <span class="drop-icon">📊</span>
        <div class="drop-label"><strong>Click to select</strong> or drag & drop</div>
        <div class="drop-label" style="margin-top:4px">CashBalances .xlsx or .xls file</div>
        <div id="calls-file-name"></div>
      </div>

      <div class="section-label">Step 2 — Enter Call Date</div>
      <div class="date-row">
        <div class="field">
          <label>Call Date</label>
          <input type="date" id="calls-call-date">
        </div>
        <div class="field">
          <label>Call Day Label <span style="font-size:0.72rem; color:var(--muted)">(auto-filled)</span></label>
          <input type="text" id="calls-call-day" placeholder="e.g. TUESDAY, MAY 12, 2026" style="font-family:var(--mono); font-size:0.8rem; padding:8px; border:1px solid var(--rule); background:var(--paper); width:100%; border-radius:3px;">
        </div>
      </div>

      <div class="section-label">Step 3 — Generate</div>
      <button id="calls-submit-btn" class="submit-btn" disabled>Generate Call Files</button>
    </div>

    <div id="calls-progress" style="display:none; margin-top:20px;">
      <span class="spinner"></span>
      <span id="calls-progress-msg">Generating call files…</span>
    </div>

    <div id="calls-result"></div>
    <button id="calls-download-btn" class="download-btn" style="display:none; margin-top:16px;">⬇ Download Call Files (.zip)</button>
    <span class="reset-link" id="calls-reset-link" style="display:none;">← Generate another set</span>

  </div><!-- end tab-gf-calls -->

  <!-- ══════════════════════════════════════════════ -->
  <!-- Tab 3: Warrant ACH File Report                 -->
  <!-- ══════════════════════════════════════════════ -->
  <div id="tab-ach-report" class="tab-panel">

    <div class="section-label" style="margin-bottom:16px;">Warrant ACH File Report</div>
    <p style="font-size:0.82rem; color:var(--muted); margin-bottom:18px; line-height:1.5;">
      Upload a PDF of scanned physical warrant faces (front + back) to generate a registration
      log spreadsheet with all warrant details, interest rates, and next interest dates
      looked up from the 8038 Info file.
    </p>

    <div id="wrl-drop" style="border:2px dashed #c5ccd6; border-radius:8px; padding:28px 20px; text-align:center; cursor:pointer; margin-bottom:14px; transition:border-color 0.2s;"
         onclick="document.getElementById('wrl-pdf-input').click()"
         ondragover="event.preventDefault(); this.style.borderColor='var(--accent)'"
         ondragleave="this.style.borderColor='#c5ccd6'"
         ondrop="event.preventDefault(); this.style.borderColor='#c5ccd6'; wrlHandleFile(event.dataTransfer.files[0])">
      <div style="font-size:0.85rem;"><strong>Click to select</strong> or drag &amp; drop</div>
      <div style="font-size:0.8rem; color:var(--muted); margin-top:4px;">Warrant faces PDF</div>
      <input type="file" id="wrl-pdf-input" accept=".pdf" style="display:none" onchange="wrlHandleFile(this.files[0])">
    </div>
    <div id="wrl-filename" style="font-size:0.78rem; color:var(--muted); margin-bottom:14px; min-height:1.2em;"></div>

    <button id="wrl-btn" disabled
            style="width:100%; padding:11px; background:var(--ink); color:#fff; border:none; border-radius:6px; font-family:var(--mono); font-size:0.78rem; letter-spacing:0.08em; text-transform:uppercase; cursor:pointer; transition:background 0.2s; opacity:0.45;"
            onclick="wrlSubmit()">
      Generate Registration Log
    </button>
    <div id="wrl-status" style="font-size:0.8rem; color:var(--muted); margin-top:10px; min-height:1.2em;"></div>
    <div id="wrl-error"  style="font-size:0.8rem; color:#c0392b; margin-top:8px; display:none;"></div>

  </div><!-- end tab-ach-report -->

  <!-- ══════════════════════════════════════════════ -->
  <!-- Tab 4: Warrant Query                           -->
  <!-- ══════════════════════════════════════════════ -->
  <div id="tab-warrant-query" class="tab-panel">

    <div class="section-label" style="margin-bottom:8px;">Warrant Query</div>
    <p style="font-size:0.82rem; color:var(--muted); margin-bottom:6px; line-height:1.5;">
      Ask any question about the warrant history dataset — totals by SID, payee lookups, outstanding balances, holder summaries, and more.
    </p>
    <div id="warrant-data-date" style="font-family:var(--mono); font-size:0.72rem; color:var(--muted); margin-bottom:18px; min-height:1em;"></div>

    <div style="position:relative;">
      <textarea id="query-input"
        placeholder="e.g. What is the total principal for Geis, Inc.? Which SIDs have over $1M outstanding? Who are the top 5 holders by principal?"
        style="width:100%; min-height:90px; padding:12px 14px; font-family:var(--serif); font-size:0.88rem; color:var(--ink); background:var(--paper); border:1px solid var(--rule); border-radius:4px; resize:vertical; line-height:1.5; outline:none;"
        onkeydown="if(event.key==='Enter' && (event.metaKey||event.ctrlKey)) submitQuery()"
      ></textarea>
      <div style="font-size:0.68rem; color:var(--muted); font-family:var(--mono); margin-top:4px; text-align:right;">
        ⌘↵ or Ctrl↵ to submit
      </div>
    </div>

    <button id="query-btn" onclick="submitQuery()"
      style="margin-top:12px; width:100%; padding:11px; background:var(--ink); color:#fff; border:none; border-radius:6px; font-family:var(--mono); font-size:0.78rem; letter-spacing:0.08em; text-transform:uppercase; cursor:pointer; transition:background 0.2s;">
      Ask
    </button>

    <div id="query-progress" style="display:none; margin-top:16px; font-family:var(--mono); font-size:0.8rem; color:var(--muted);">
      <span class="spinner"></span> Querying warrant data…
    </div>
    <div id="query-error" style="display:none; margin-top:14px; font-size:0.82rem; color:var(--error); font-family:var(--mono);"></div>

    <div id="query-history" style="margin-top:20px;"></div>

  </div><!-- end tab-warrant-query -->

</main>

<script>
  // ── State ──
  let extractedData = null;
  let dtWt = '', dtReg = '';

  // ── UI refs ──
  const dropZone    = document.getElementById('drop-zone');
  const pdfInput    = document.getElementById('pdf-input');
  const fileNameEl  = document.getElementById('file-name');
  const dtWtInput   = document.getElementById('dt-wt');
  const dtRegInput  = document.getElementById('dt-reg');
  const submitBtn   = document.getElementById('submit-btn');
  const progressEl  = document.getElementById('progress');
  const progressMsg = document.getElementById('progress-msg');
  const errorBox    = document.getElementById('error-box');
  const resultsEl   = document.getElementById('results');
  const uploadForm  = document.getElementById('upload-form');

  // ── Drag & drop ──
  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
  dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    const f = e.dataTransfer.files[0];
    if (f && f.type === 'application/pdf') {
      pdfInput.files = e.dataTransfer.files;
      fileNameEl.textContent = f.name;
      checkReady();
    }
  });
  pdfInput.addEventListener('change', () => {
    fileNameEl.textContent = pdfInput.files[0]?.name || '';
    checkReady();
  });
  dtWtInput.addEventListener('change', checkReady);
  dtRegInput.addEventListener('change', checkReady);

  function checkReady() {
    submitBtn.disabled = !(pdfInput.files.length && dtWtInput.value && dtRegInput.value);
  }

  // ── Formatting ──
  function fmt(n) {
    return Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  // ── Render warrant table ──
  function renderTable(bodyId, totalId, warrants) {
    const tbody = document.getElementById(bodyId);
    const totalEl = document.getElementById(totalId);
    tbody.innerHTML = '';

    warrants.forEach((w, i) => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="wt-num"><input type="number" value="${w.warrant_number}" data-field="warrant_number" data-idx="${i}" data-section="${bodyId}"></td>
        <td class="payee"><input type="text" value="${w.payee}" data-field="payee" data-idx="${i}" data-section="${bodyId}"></td>
        <td class="amount"><input type="number" step="0.01" value="${w.amount}" data-field="amount" data-idx="${i}" data-section="${bodyId}" style="text-align:right"></td>
      `;
      tbody.appendChild(tr);
    });

    updateTotal(bodyId, totalId);

    // Live edit -> update state & totals
    tbody.addEventListener('input', e => {
      const el = e.target;
      const idx = parseInt(el.dataset.idx);
      const field = el.dataset.field;
      const section = el.dataset.section;
      const list = section === 'gf-body' ? extractedData.general_warrants : extractedData.construction_warrants;
      list[idx][field] = field === 'amount' ? parseFloat(el.value) || 0 : (field === 'warrant_number' ? parseInt(el.value) : el.value);
      if (field === 'amount') updateTotal(bodyId, totalId);
    });
  }

  function updateTotal(bodyId, totalId) {
    const list = bodyId === 'gf-body' ? extractedData.general_warrants : extractedData.construction_warrants;
    const total = list.reduce((s, w) => s + (parseFloat(w.amount) || 0), 0);
    document.getElementById(totalId).textContent = '$' + fmt(total);
  }

  // ── Submit ──
  submitBtn.addEventListener('click', async () => {
    errorBox.style.display = 'none';
    submitBtn.disabled = true;
    uploadForm.style.opacity = '0.4';
    progressEl.style.display = 'block';
    progressMsg.textContent = 'Reading PDF with AI…';
    const formData = new FormData();
    formData.append('pdf', pdfInput.files[0]);
    formData.append('dt_wt', dtWtInput.value);
    formData.append('dt_reg', dtRegInput.value);

    try {
      const resp = await fetch('/api/process', { method: 'POST', body: formData });
      let json;
      try { json = await resp.json(); } catch(_) {
        if (resp.status === 413) throw new Error('PDF is too large to upload (max 50MB).');
        throw new Error(`Server error ${resp.status} — please try again.`);
      }
      if (!resp.ok || !json.success) {
        throw new Error(json.error || 'Unknown error');
      }

      extractedData = json.data;
      dtWt  = json.dt_wt;
      dtReg = json.dt_reg;

      progressEl.style.display = 'none';
      uploadForm.style.display = 'none';

      // Populate results
      const county = (extractedData.county || 'Sarpy').trim().toLowerCase();
      const sidLabel = county === 'douglas'
        ? `SID ${extractedData.sid_number} — Douglas County`
        : `SID ${extractedData.sid_number} — ${extractedData.sid_name}`;
      document.getElementById('result-title').textContent = sidLabel;
      const totalWarrants = extractedData.general_warrants.filter(w => !w.void).length
                          + extractedData.construction_warrants.filter(w => !w.void).length;
      document.getElementById('sid-badge').textContent = `${totalWarrants} warrants`;

      // Render flags
      const flags = json.flags || [];
      const flagsPanel = document.getElementById('flags-panel');
      const flagsList  = document.getElementById('flags-list');
      const flagsAck   = document.getElementById('flags-acknowledge');
      const dlBtn      = document.getElementById('download-btn');
      flagsList.innerHTML = '';

      if (flags.length > 0) {
        const hasErrors = flags.some(f => f.severity === 'error');
        flags.forEach(f => {
          const div = document.createElement('div');
          div.className = `flag-item ${f.severity}`;
          div.innerHTML = `
            <span class="flag-badge">${f.severity}</span>
            <span><span class="flag-warrant">${f.warrant !== 'N/A' ? 'Wt# ' + f.warrant + ' — ' : ''}${f.field.charAt(0).toUpperCase() + f.field.slice(1)}:</span> ${f.message}</span>
          `;
          flagsList.appendChild(div);
        });
        flagsPanel.style.display = 'block';
        flagsAck.style.display = 'flex';
        dlBtn.disabled = true;

        document.getElementById('flags-ack-check').addEventListener('change', function() {
          dlBtn.disabled = !this.checked;
        });
      } else {
        flagsPanel.style.display = 'none';
        dlBtn.disabled = false;
      }

      renderTable('gf-body', 'gf-total', extractedData.general_warrants);
      renderTable('cf-body', 'cf-total', extractedData.construction_warrants);

      resultsEl.style.display = 'block';

    } catch (err) {
      progressEl.style.display = 'none';
      uploadForm.style.opacity = '1';
      submitBtn.disabled = false;
      errorBox.textContent = '⚠ ' + err.message;
      errorBox.style.display = 'block';
    }
  });

  // ── Download ──
  document.getElementById('download-btn').addEventListener('click', async () => {
    const btn = document.getElementById('download-btn');
    btn.textContent = 'Generating…';
    btn.disabled = true;

    try {
      const resp = await fetch('/api/download', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ data: extractedData, dt_wt: dtWt, dt_reg: dtReg })
      });

      if (!resp.ok) {
        const err = await resp.json();
        throw new Error(err.error || 'Download failed');
      }

      const blob = await resp.blob();
      const url  = URL.createObjectURL(blob);
      const a    = document.createElement('a');
      const sid  = extractedData.sid_number;
      const mm   = dtReg.slice(5,7);
      const dd   = dtReg.slice(8,10);
      const yyyy = dtReg.slice(0,4);
      // Use zip extension — server always returns a zip containing the reg sheet + 8038 forms
      a.href     = url;
      a.download = `SID_${sid}_${mm}-${dd}-${yyyy}.zip`;
      a.click();
      URL.revokeObjectURL(url);

    } catch (err) {
      errorBox.textContent = '⚠ ' + err.message;
      errorBox.style.display = 'block';
    } finally {
      btn.textContent = '⬇ Download Packet Files';
      btn.disabled = false;
    }
  });

  // ── Reset ──
  document.getElementById('reset-link').addEventListener('click', () => {
    extractedData = null;
    dtWt = dtReg = '';
    pdfInput.value = '';
    fileNameEl.textContent = '';
    dtWtInput.value = '';
    dtRegInput.value = '';
    submitBtn.disabled = true;
    errorBox.style.display = 'none';
    resultsEl.style.display = 'none';
    document.getElementById('flags-panel').style.display = 'none';
    document.getElementById('flags-list').innerHTML = '';
    document.getElementById('flags-ack-check').checked = false;
    document.getElementById('download-btn').disabled = false;
    uploadForm.style.display = 'block';
    uploadForm.style.opacity = '1';
  });
</script>


<script>
  let wrlFile = null;

  function wrlHandleFile(file) {
    if (!file || file.type !== 'application/pdf') return;
    wrlFile = file;
    document.getElementById('wrl-filename').textContent = file.name;
    const btn = document.getElementById('wrl-btn');
    btn.disabled = false;
    btn.style.opacity = '1';
    btn.style.cursor = 'pointer';
  }

  async function wrlSubmit() {
    const btn    = document.getElementById('wrl-btn');
    const status = document.getElementById('wrl-status');
    const errBox = document.getElementById('wrl-error');
    errBox.style.display = 'none';
    btn.disabled = true;
    btn.style.opacity = '0.45';

    try {
      // ── Step 1: upload PDF and start background job ──
      status.textContent = 'Uploading PDF…';
      const fd = new FormData();
      fd.append('pdf', wrlFile);
      const startResp = await fetch('/api/register-warrants', { method: 'POST', body: fd });

      if (!startResp.ok) {
        let errMsg = `Server error ${startResp.status}`;
        try { const e = await startResp.json(); errMsg = e.error || errMsg; } catch(_) {
          if (startResp.status === 413) errMsg = 'PDF is too large to upload (max 50MB).';
        }
        throw new Error(errMsg);
      }

      const { job_id } = await startResp.json();
      if (!job_id) throw new Error('No job ID returned from server.');

      // ── Step 2: poll for completion ──
      let elapsed = 0;
      while (true) {
        await new Promise(r => setTimeout(r, 5000));  // poll every 5s
        elapsed += 5;

        const mins = Math.floor(elapsed / 60);
        const secs = elapsed % 60;
        const timeStr = mins > 0 ? `${mins}m ${secs}s` : `${secs}s`;
        status.textContent = `Extracting warrants… ${timeStr} elapsed (large PDFs may take 2–4 minutes).`;

        const pollResp = await fetch(`/api/register-warrants/status/${job_id}`);
        if (!pollResp.ok) throw new Error(`Status check failed (${pollResp.status})`);
        const poll = await pollResp.json();

        if (poll.status === 'error') throw new Error(poll.error || 'Extraction failed');

        if (poll.status === 'done') {
          // ── Step 3: download the file ──
          status.textContent = 'Downloading…';
          const dlResp = await fetch(`/api/register-warrants/download/${job_id}`);
          if (!dlResp.ok) throw new Error('Download failed');
          const blob = await dlResp.blob();
          const url  = URL.createObjectURL(blob);
          const a    = document.createElement('a');
          a.download = poll.filename || 'Warrant_Registration_Log.xlsx';
          a.href = url;
          a.click();
          URL.revokeObjectURL(url);
          status.textContent = '✓ Downloaded successfully.';
          break;
        }
        // status === 'running' — keep polling
      }

    } catch (err) {
      errBox.textContent  = '⚠ ' + err.message;
      errBox.style.display = 'block';
      status.textContent  = '';
    } finally {
      btn.disabled = false;
      btn.style.opacity = '1';
    }
  }

  // ── Tab switching ──────────────────────────────────────────────────────────
  function switchTab(tabName, btnEl) {
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + tabName).classList.add('active');
    btnEl.classList.add('active');
    if (tabName === 'warrant-query') loadWarrantDate();
  }

  async function loadWarrantDate() {
    const el = document.getElementById('warrant-data-date');
    if (!el || el.dataset.loaded) return;
    try {
      const resp = await fetch('/api/warrant-date');
      const data = await resp.json();
      if (data.date) {
        el.textContent = 'Data as of: ' + data.date;
        el.dataset.loaded = '1';
      }
    } catch (e) { /* silent */ }
  }

  // ── GF Calls ───────────────────────────────────────────────────────────────
  const callsFileInput  = document.getElementById('calls-file-input');
  const callsFileName   = document.getElementById('calls-file-name');
  const callsDropZone   = document.getElementById('calls-drop-zone');
  const callsCallDate   = document.getElementById('calls-call-date');
  const callsCallDay    = document.getElementById('calls-call-day');
  const callsSubmitBtn  = document.getElementById('calls-submit-btn');
  const callsProgress   = document.getElementById('calls-progress');
  const callsProgressMsg = document.getElementById('calls-progress-msg');
  const callsResult     = document.getElementById('calls-result');
  const callsDownloadBtn = document.getElementById('calls-download-btn');
  const callsResetLink  = document.getElementById('calls-reset-link');

  let callsZipBlob = null;
  let callsZipName = '';

  // File input
  callsFileInput.addEventListener('change', () => {
    if (callsFileInput.files[0]) {
      callsFileName.textContent = callsFileInput.files[0].name;
      checkCallsReady();
    }
  });

  // Drag & drop for calls zone
  callsDropZone.addEventListener('dragover', e => { e.preventDefault(); callsDropZone.classList.add('drag-over'); });
  callsDropZone.addEventListener('dragleave', () => callsDropZone.classList.remove('drag-over'));
  callsDropZone.addEventListener('drop', e => {
    e.preventDefault();
    callsDropZone.classList.remove('drag-over');
    const f = e.dataTransfer.files[0];
    if (f) {
      callsFileInput.files = e.dataTransfer.files;
      callsFileName.textContent = f.name;
      checkCallsReady();
    }
  });
  callsDropZone.addEventListener('click', () => callsFileInput.click());

  // Auto-fill call day label when date changes
  callsCallDate.addEventListener('change', () => {
    if (callsCallDate.value) {
      const d = new Date(callsCallDate.value + 'T12:00:00');
      const dayNames = ['SUNDAY','MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY'];
      const monthNames = ['JANUARY','FEBRUARY','MARCH','APRIL','MAY','JUNE',
                          'JULY','AUGUST','SEPTEMBER','OCTOBER','NOVEMBER','DECEMBER'];
      callsCallDay.value = `${dayNames[d.getDay()]}, ${monthNames[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;
    }
    checkCallsReady();
  });

  function checkCallsReady() {
    callsSubmitBtn.disabled = !(callsFileInput.files[0] && callsCallDate.value);
  }

  // Submit
  callsSubmitBtn.addEventListener('click', async () => {
    callsSubmitBtn.disabled = true;
    callsProgress.style.display = 'block';
    callsProgressMsg.textContent = 'Generating call files…';
    callsResult.style.display = 'none';
    callsResult.className = '';
    callsDownloadBtn.style.display = 'none';
    callsResetLink.style.display = 'none';
    callsZipBlob = null;

    try {
      const fd = new FormData();
      fd.append('cash_file', callsFileInput.files[0]);
      fd.append('call_date', callsCallDate.value);
      fd.append('call_day',  callsCallDay.value);

      const resp = await fetch('/api/gf-calls', { method: 'POST', body: fd });

      if (!resp.ok) {
        const err = await resp.json().catch(() => ({ error: resp.statusText }));
        throw new Error(err.error || 'Server error');
      }

      callsZipBlob = await resp.blob();
      // Get filename from Content-Disposition header if available
      const cd = resp.headers.get('Content-Disposition') || '';
      const m  = cd.match(/filename="?([^"]+)"?/);
      callsZipName = m ? m[1] : `GF_Calls_${callsCallDate.value}.zip`;

      callsResult.textContent = `✓ Done. Ready to download ${callsZipName}`;
      callsResult.className   = 'success';
      callsResult.style.display = 'block';
      callsDownloadBtn.style.display = 'inline-block';
      callsResetLink.style.display   = 'inline-block';

    } catch (err) {
      callsResult.textContent = '⚠ ' + err.message;
      callsResult.className   = 'error';
      callsResult.style.display = 'block';
      callsSubmitBtn.disabled = false;
    } finally {
      callsProgress.style.display = 'none';
    }
  });

  // Download zip
  callsDownloadBtn.addEventListener('click', () => {
    if (!callsZipBlob) return;
    const url = URL.createObjectURL(callsZipBlob);
    const a   = document.createElement('a');
    a.href     = url;
    a.download = callsZipName;
    a.click();
    URL.revokeObjectURL(url);
  });

  // Reset
  callsResetLink.addEventListener('click', () => {
    callsFileInput.value   = '';
    callsFileName.textContent = '';
    callsCallDate.value    = '';
    callsCallDay.value     = '';
    callsResult.style.display    = 'none';
    callsDownloadBtn.style.display = 'none';
    callsResetLink.style.display   = 'none';
    callsSubmitBtn.disabled = true;
    callsZipBlob = null;
  });

  // ── Warrant Query ─────────────────────────────────────────────────────────
  async function submitQuery() {
    const input    = document.getElementById('query-input');
    const btn      = document.getElementById('query-btn');
    const progress = document.getElementById('query-progress');
    const errorEl  = document.getElementById('query-error');
    const history  = document.getElementById('query-history');

    const question = input.value.trim();
    if (!question) return;

    btn.disabled = true;
    btn.style.opacity = '0.5';
    progress.style.display = 'block';
    errorEl.style.display  = 'none';

    try {
      // 4-minute timeout aligned with gunicorn worker timeout. The first query of the
      // day typically takes 30-60s (cache write); subsequent queries within 5 minutes
      // benefit from prompt caching and return much faster.
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 240000);

      let resp;
      try {
        resp = await fetch('/api/warrant-query', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question }),
          signal: controller.signal
        });
      } catch (fetchErr) {
        if (fetchErr.name === 'AbortError') {
          throw new Error('Request timed out after 4 minutes. The server may be under heavy load — please try again in a moment.');
        }
        throw new Error('Connection failed: ' + fetchErr.message + '. If this persists, the server may have restarted — try again.');
      } finally {
        clearTimeout(timeoutId);
      }

      const data = await resp.json();
      if (!resp.ok) throw new Error(data.error || 'Request failed');

      // Prepend new Q&A to history
      const entry = document.createElement('div');
      entry.className = 'query-entry';
      entry.innerHTML =
        '<div class="q-label">Question</div>' +
        '<div class="q-text">' + question.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</div>' +
        '<div class="a-label">Answer</div>' +
        '<div class="a-text">' + data.answer.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</div>';
      history.insertBefore(entry, history.firstChild);
      input.value = '';

    } catch (err) {
      errorEl.textContent = '⚠ ' + err.message;
      errorEl.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.style.opacity = '1';
      progress.style.display = 'none';
    }
  }
</script>
</body>
